# CRM Application Configuration
# Copy this file to .env and update the values

# Application Settings
SECRET_KEY=your-very-secure-secret-key-32-chars-minimum-change-this
SESSION_COOKIE_NAME=crm_session
APP_USERNAME=admin
APP_PASSWORD=your-secure-password-here

# Locale and Timezone (Serbian settings)
LOCALE=sr
TIMEZONE=Europe/Belgrade

# Database Configuration
# For SQLite (development) - НЕ ИСПОЛЬЗУЙТЕ В ПРОДАКШЕНЕ
# DATABASE_URL=sqlite:///app.db

# For PostgreSQL (production) - ОБЯЗАТЕЛЬНО для Hostinger VPS
DATABASE_URL=postgresql://crm_user:crm_password@db:5432/crm_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Hostinger VPS Specific Settings
# Раскомментируйте и настройте для вашего домена
# DOMAIN=your-domain.com
# SSL_EMAIL=your-email@domain.com
