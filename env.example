# Database
DATABASE_URL=sqlite:///app.db

# Security
SECRET_KEY=your-secret-key-change-me-in-production
SESSION_COOKIE_NAME=crm_session

# Legacy settings (for backward compatibility)
APP_USERNAME=admin
APP_PASSWORD=admin123

# Admin Settings
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin123
SUPER_ADMIN_EMAIL=superadmin@lovacrm.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@lovacrm.com

# App Settings
LOCALE=sr
TIMEZONE=Europe/Belgrade

# Google Maps API (опционально, для получения рейтингов)
# Получите ключ на https://console.cloud.google.com/
# Включите Places API в Google Cloud Console
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here